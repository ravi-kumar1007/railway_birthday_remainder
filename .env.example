# Copy to .env.local for local development and fill in. Never commit .env.local.
# In Netlify/Vercel, set the same names in the site's environment variables UI.

# --- Database (Neon) ---
# Neon dashboard → Connect → copy the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Admin login ---
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password
# In .env.local every $ must be escaped as \$ (the script prints it that way).
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# --- Daily job ---
# Random string; cron-job.org sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Meta WhatsApp Cloud API ---
# Graph API version (v26.0 is current as of Oct 2026). Check https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_VERSION=v26.0
# System user permanent access token with whatsapp_business_messaging + whatsapp_business_management
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# App dashboard → App settings → Basic → App secret (verifies webhook signatures)
META_APP_SECRET=
# Any random string; enter the same value when configuring the webhook in Meta
META_WEBHOOK_VERIFY_TOKEN=

# --- App ---
NEXT_PUBLIC_COMPANY_NAME=Acme Pvt Ltd
APP_TIMEZONE=Asia/Kolkata
